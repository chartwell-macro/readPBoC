Package: readPBOC
Title: Read People's Bank of China Data and Statistical Releases
Version: 0.1.2
Authors@R:
    person("Chartwell", "Macro",
           email = "chartwellmacro@gmail.com",
           role = c("aut", "cre"))
Description: Discovers, downloads, reads, and normalises statistical data
    published by the People's Bank of China ('PBOC'). Both the more
    comprehensive Chinese website and the English website are supported,
    including spreadsheet data, statistical-release indexes, release text,
    attachments, and revision-aware download manifests.
License: MIT + file LICENSE
Depends:
    R (>= 4.1.0)
Imports:
    curl,
    readxl,
    rvest,
    tibble,
    xml2
Suggests:
    dplyr,
    DT,
    ggplot2,
    knitr,
    pkgload,
    rmarkdown,
    scales,
    testthat (>= 3.0.0)
Config/testthat/edition: 3
Encoding: UTF-8
